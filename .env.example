# ==============================================================================
# SantexPro Platform Environment Configuration Example (.env.example)
# Do NOT put real secrets in this file. Copy to .env and set actual values.
# ==============================================================================

# Application Environment: 'development', 'testing', 'staging', or 'production'
DJANGO_ENV=development
DJANGO_SETTINGS_MODULE=santexpro.settings.development

# Django Secret Key (Generate a cryptographically secure key for production)
SECRET_KEY=change-me-to-a-secure-random-secret-key

# Debug Mode (MUST be False in production)
DEBUG=True

# Allowed Hosts (comma-separated domains)
ALLOWED_HOSTS=127.0.0.1,localhost,santexpro.uz

# PostgreSQL Database Settings (PostgreSQL is required)
DB_NAME=santexpro
DB_USER=postgres
DB_PASSWORD=your_secure_db_password
DB_HOST=localhost
DB_PORT=5433

# CORS Allowed Origins (comma-separated URLs)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Logging Level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
